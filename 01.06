class Monster:
    def __init__(self, name, hp, dmg):
        self.__name = name
        self.__hp = hp
        self.__dmg = dmg

    def get_name(self):
        return self.__name

    def get_hp(self):
        return self.__hp

    def get_dmg(self):
        return self.__dmg

    def set_hp(self, value):
        if value < 0:
            self.__hp = 0

    def is_alive(self):
        if self.__hp > 0:
            return True
        else:
            return False

    def show_status(self):
        print(f"{self.get_name()} HP: {self.get_hp()}")

    def take_damage(self, damage):
        self.__hp -= damage

    def attack_hunter(self, hunter):
        if self.__hp > 0:
            hunter.take_damage(self.__dmg)
        else:
            print("Нет здоровья")


class Zombie(Monster):
    def __init__(self, name):
        super().__init__(name, hp=120, dmg=10)

    def take_damage(self, damage):
        super().take_damage(damage)
        if damage >= 30:
            print("Зомби теряет конечность!")
        print(f"Зомби Получил {damage} урона, HP: {self.get_hp()}")


class Vampire(Monster):
    def __init__(self, name):
        super().__init__(name, hp=80, dmg=15)

    def take_damage(self, damage):
        damage -= 5
        super().take_damage(damage)
        print("Дракула поглощает 5 урона!")
        print(f"Получено {damage} урона, HP: {self.get_hp()}")


class Ghost(Monster):
    def __init__(self, name):
        super().__init__(name, hp=60, dmg=20)

    def take_damage(self, damage):
        import random
        if random.random() <= 0.3:
            print("Удар прошел сквозь призрака")
        else:
            super().take_damage(damage)
            print(f"Призрак получил {damage} урона, HP: {self.get_hp()}")


class Werewolf(Monster):
    def __init__(self, name):
        super().__init__(name, hp=100, dmg=25)

    def take_damage(self, damage):
        super().take_damage(damage)
        if self.get_hp() < 50:
            print("Превращается в оборотня")
        print(f"Оборотень получил {damage} урона, HP: {self.get_hp()}")


class Weapon:
    def __init__(self, name):
        self.name = name

    def use(self, monster):
        pass


class SilverSword(Weapon):
    def __init__(self):
        super().__init__("SilverSword")

    def use(self, monster):
        damage = 30
        print("удар серебряным мечем")
        monster.take_damage(damage)


class HolyWater(Weapon):
    def __init__(self):
        super().__init__("HolyWater")

    def use(self, monster):
        damage = 20
        print("Брызги святой воды")
        monster.take_damage(damage)


class CrossbowBolt(Weapon):
    def __init__(self):
        super().__init__("CrossBow")

    def use(self, monster):
            damage = 25
            print("выстрел из арбалета")
            monster.take_damage(damage)


class Hunter:
    def __init__(self, __name, __hp=100):
        self.__name = __name
        self.__hp = __hp
        self.__weapons = []

    def get_name(self):
        return self.__name

    def get_hp(self):
        return self.__hp

    def set_hp(self, value):
        if value < 0:
            self.__hp = 0

    def add_weapon(self, weapon):
        self.__weapons.append(weapon)

    def show_inventory(self):
        for i, weapon in enumerate(self.__weapons):
            print(f"содержимое инвентаря: {i}. {self.__weapons[i].name}")

    def attack(self, weapon_index, monster):
        if weapon_index < 0 or weapon_index >= len(self.__weapons):
            return
        self.__weapons[weapon_index].use(monster)

    def is_alive(self):
        if self.__hp > 0:
            return True
        else:
            return False

    def take_damage(self, damage):
        self.__hp -= damage


import random

def run_game():
    hunter = Hunter("Хельсинг")
    hunter.add_weapon(CrossbowBolt())
    hunter.add_weapon(HolyWater())
    hunter.add_weapon(SilverSword())

    monsters = [Zombie("Зомби"), Vampire("Дракула"), Ghost("Призрак"), Werewolf("Оборотень")]

    for monster in monsters:
        print(f'Текущий  враг: {monster.get_name()}')

        while monster.is_alive() and hunter.is_alive():
            weapon_index = random.randint(0, 2)
            hunter.attack(weapon_index, monster)
            if monster.is_alive():
                monster.attack_hunter(hunter)

            print(f'{hunter.get_name()} HP: {hunter.get_hp()}')

        if not hunter.is_alive():
            print("Охотник потерпел поражение")
            break
        print(f"{monster.get_name()} повержен")
    if not monster.is_alive():
        print("Все монстры убиты, Победа!")
run_game()

